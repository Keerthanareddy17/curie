# Copy to .env and adjust as needed. All values shown are defaults.
# None of curie's core tools (ESM Atlas, UniProt, IEDB, Europe PMC) require an API key.

# Optional. Gemini is curie's reasoning/planning/synthesis layer (research
# planning + evidence narration) — never the evidence layer, and never a
# single point of failure: curie runs the full deterministic investigation
# and produces a complete dossier without this set. See docs/LIMITATIONS.md
# and curie/tools/gemini.py. No CURIE_ prefix — same variable name any
# Gemini-based tool expects.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

CURIE_LOG_LEVEL=INFO
CURIE_LOG_FORMAT=json

CURIE_HOST=0.0.0.0
CURIE_PORT=8000

# Comma-separated extra allowed CORS origins, for a deployed frontend calling
# this backend from a different domain (e.g. Vercel). Local dev origins
# (localhost:5173) are always allowed regardless of this setting.
# CURIE_CORS_ORIGINS=https://your-app.vercel.app

CURIE_HTTP_TIMEOUT_SECONDS=20

CURIE_ESM_ATLAS_BASE_URL=https://api.esmatlas.com
CURIE_UNIPROT_BASE_URL=https://rest.uniprot.org
CURIE_IEDB_BASE_URL=https://query-api.iedb.org
CURIE_EUROPE_PMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
